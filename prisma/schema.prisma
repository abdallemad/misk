// ============================================================
// Misk Perfume Catalog — Prisma Schema
// Based on: misk_business_analysis.md
// ============================================================
//
// Design notes:
// - Each perfume is a parent Product with one or many Variants
//   (variant-based selling rather than fixed SKUs).
// - Two product types exist: ALCOHOL (sold by bottle size only)
//   and RAW_OIL / "Duhn" (sold by weight).
//   Rather than splitting into two tables, Variant carries nullable
//   fields for each type and a check is enforced at the app layer
//   (see comment above Variant) — this keeps "one perfume, many
//   purchasable options" on a single product page, per section 5.
//   Bottle style (luxury/regular) was dropped after section 4.1 —
//   see docs/products-feature.md, "The bottle-style axis was removed".
// - Ingredients are modeled as their own table so the same raw
//   material (e.g. "Amber Oud oil, Grade A") can be reused/reported
//   on across many products, and so the admin can update
//   descriptions per grade/batch (section 7, point 4) independently
//   of the product copy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

/// Two distinct product formats requiring different variant data — section 4
enum ProductType {
  ALCOHOL_BASED
  RAW_OIL
}

/// Bottle size in ml — alcohol-based line only — section 4.1
enum BottleSize {
  ML_30
  ML_50
  ML_100
}

/// Fill weight in grams — raw oil / "Duhn" line only — section 4.2
enum OilWeight {
  G_5
  G_8
  G_12
}

// ------------------------------------------------------------
// Core catalog
// ------------------------------------------------------------

/// Audience segment — "شبابي" / "نسائي" / "رجالي" — section 3.
///
/// A table rather than an enum, because the admin console creates, renames
/// and retires segments at runtime (see docs/categories-feature.md). An enum
/// would put every such change behind a migration and a deploy.
///
/// `slug` is the URL segment for `/shop/[category]` and the key the design
/// system's `CATEGORY_ACCENT` map is keyed by, so it is Latin, lowercase and
/// immutable in spirit: renaming `name` is free, changing `slug` breaks
/// every link that has already been shared.
model Category {
  id          String   @id @default(cuid())
  /// Arabic display label — "شبابي".
  name        String   @unique
  /// URL segment — "youth". Latin lowercase, digits and hyphens only.
  slug        String   @unique
  /// One line of scent copy — "برغموت وحمضيات، نفَس منعش".
  description String?
  /// Public path under `/uploads`, written by `lib/uploads.ts`. Nullable
  /// because a segment is useful before anyone has photographed it.
  imageUrl    String?
  /// Hides the segment from the storefront without deleting it — the
  /// reversible alternative to a delete that `onDelete: Restrict` forbids.
  isActive    Boolean  @default(true)
  /// Manual sort order for the storefront's category nav. Ties break by name.
  position    Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([isActive, position])
}

/// Parent product — one perfume, e.g. "Misk Rose" — section 5
model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String

  /// `Restrict`, not `Cascade`: deleting a segment must never take a
  /// shelf of perfumes with it. The service turns the resulting foreign-key
  /// error into "retire it instead" — see category.service.ts.
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId  String

  productType ProductType

  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  images      ProductImage[]
  ingredients ProductIngredient[]
  variants    ProductVariant[]

  @@index([categoryId])
  @@index([productType])
}

/// Image gallery — multiple photos per product — section 3 & 7
model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  position  Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

/// Raw material master list — fragrance oil grades, ethanol type, etc.
/// Lets the "Quality & Ingredients" trust section (section 6) reuse
/// the same material entry across many products.
model Ingredient {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "Medical-Grade Ethanol", "Oud Oil - Grade A"
  description String?

  products    ProductIngredient[]
}

/// Join table: which ingredients appear in which product, in what role
model ProductIngredient {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String
  note         String?    // e.g. "base diluent", "top note oil"

  @@unique([productId, ingredientId])
}

// ------------------------------------------------------------
// Variants (purchasable options)
// ------------------------------------------------------------

/// A single purchasable combination under a product page — section 5.
///
/// Population rules (enforced in application/service layer, since
/// Prisma has no native CHECK-constraint DSL):
///   - product.productType == ALCOHOL_BASED  ->  bottleSize is required;
///     oilWeight must be null.
///   - product.productType == RAW_OIL        ->  oilWeight is required;
///     bottleSize must be null.
///
/// oilGrade is free-text on every variant since price varies by
/// (size/weight × oil grade), and grades/batches change over time
/// (section 7, point 4).
model ProductVariant {
  id          String       @id @default(cuid())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String

  // Alcohol-based fields
  bottleSize  BottleSize?

  // Raw oil fields
  oilWeight   OilWeight?

  // Shared
  oilGrade    String?      // e.g. "Grade A", "Premium Batch 3"
  sku         String       @unique
  price       Decimal      @db.Decimal(10, 2)
  currency    String       @default("SAR")
  stock       Int          @default(0)
  isActive    Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderItems  OrderItem[]

  @@index([productId])
  @@unique([productId, bottleSize, oilWeight, oilGrade], name: "uniqueVariantCombination")
}

// ------------------------------------------------------------
// Orders (minimal — supports "made-to-order" checkout flow, section 8)
// ------------------------------------------------------------

/// Who a signed-in person is to the shop. Mirrored from Clerk
/// `publicMetadata.role` — see the note on `User.role`.
enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Application user, mirrored from Clerk — Clerk owns the credentials,
/// this table owns everything the catalog needs a foreign key to (orders).
///
/// The row is written by `syncCurrentUser()` (services/auth.service.ts) when
/// the browser lands on `/auth-callback` after a sign-in or sign-up, and
/// re-written on every subsequent visit so a profile edit in Clerk lands
/// here too. `clerkId` — not `email` — is the join key, because a person can
/// change their primary email address in Clerk and stay the same user.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  phone     String?

  /// Mirrored from Clerk `publicMetadata.role`. Clerk stays the source of
  /// truth — `/admin` is gated on the Clerk value, not on this column — but
  /// the mirror lets the admin users list filter and sort by role without
  /// an API round trip per row.
  role      Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([role])
}

model Order {
  id         String      @id @default(cuid())
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(10, 2)
  currency   String      @default("SAR")

  /// Shipping address — a snapshot captured at checkout, the same principle as
  /// the price and variant label on `OrderItem`: editing a saved address later
  /// must not rewrite where past orders were sent. All nullable because orders
  /// placed before this feature existed carry none, and the admin orders
  /// console renders "لا يوجد عنوان" for that case rather than blank fields.
  shippingName        String?
  shippingPhone       String?
  shippingPhone2      String? /// alternate contact number, collected at checkout
  shippingGovernorate String? /// محافظة — one of EGYPT_GOVERNORATES (src/constants/egypt.ts), a dropdown at checkout
  shippingCity        String? /// المدينة
  shippingCenter      String? /// المركز
  shippingStreet      String? /// الشارع
  shippingBuilding    String? /// العمارة
  shippingCountry     String? @default("EG")

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id         String         @id @default(cuid())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantId  String
  quantity   Int            @default(1)
  unitPrice  Decimal        @db.Decimal(10, 2) // snapshot at time of order

  @@index([orderId])
  @@index([variantId])
}
